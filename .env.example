# ── Server ─────────────────────────────────────────────────────────
PORT=4000

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Falls back to localhost only if unset.
# Production: set to your Vercel frontend URL + Railway admin URL
# Local dev: include your LAN IP variants
ALLOWED_ORIGINS=https://deepfeed-ai.vercel.app,https://deepfeedai-admin-production.up.railway.app

# ── Auth ───────────────────────────────────────────────────────────
# REQUIRED — server will refuse to start if either is missing
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_PASSWORD=change_this_to_a_strong_password

# ── Database ───────────────────────────────────────────────────────
# Neon Postgres connection string (Railway / Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── ElevenLabs TTS ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# ── Cloudflare R2 (production audio storage) ───────────────────────
# Leave blank to use local file storage (dev only)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=deepfeedai-media
R2_PUBLIC_URL=https://media.deepfeedai.com
