# ============================================
# DeepFeedAI Admin — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Run scripts/setup.sh to auto-generate secrets.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/deepfeedai

# --- Secrets (optional — auto-generated and stored in settings table if not set) ---
# JWT_SECRET=
# USER_JWT_SECRET=
# CRON_SECRET=

# --- Deployment Mode ---
# Default is single-tenant (self-hosted). Set to 'multi' for SaaS multi-tenant mode.
# DEPLOYMENT_MODE=multi

# --- Instance Name (optional — for identifying instances in logs and /api/instance-info) ---
# INSTANCE_NAME=

# --- Storage ---
# Options: local (default), database, s3
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./public/media

# For S3/R2:
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=
# S3_REGION=auto

# --- Encryption ---
SETTINGS_ENCRYPTION_KEY=   # 64-char hex, auto-generated by setup.sh

# --- OAuth (optional) ---
# OAuth credentials can be configured via Settings > Authentication in the admin UI
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- AI APIs (optional, can also be set via admin settings) ---
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Email (optional) ---
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# --- Admin Password (optional — if not set, first-boot setup wizard creates admin) ---
# ADMIN_PASSWORD=
