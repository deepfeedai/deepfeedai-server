# ============================================
# DeepFeedAI Admin — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# Run scripts/setup.sh to auto-generate secrets.

# --- Required ---
DATABASE_URL=postgresql://user:password@localhost:5432/deepfeedai

# --- Secrets (optional — auto-generated and stored in settings table if not set) ---
# JWT_SECRET=
# USER_JWT_SECRET=
# CRON_SECRET=

# --- Deployment Mode ---
# Set to 'single' for self-hosted single-tenant deployments
# DEPLOYMENT_MODE=single

# --- Storage ---
# Options: local (default), database, s3
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=./public/media

# For S3/R2:
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=
# S3_REGION=auto

# --- Encryption ---
SETTINGS_ENCRYPTION_KEY=   # 64-char hex, auto-generated by setup.sh

# --- OAuth (optional) ---
# OAuth credentials can be configured via Settings > Authentication in the admin UI
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- AI APIs (optional, can also be set via admin settings) ---
# GEMINI_API_KEY=
# ELEVENLABS_API_KEY=

# --- Email (optional) ---
# RESEND_API_KEY=
# RESEND_AUDIENCE_ID=

# --- Admin Password (for non-OAuth admin login) ---
# ADMIN_PASSWORD=
