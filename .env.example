# ── Server ─────────────────────────────────────────────────────────
PORT=4000

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Falls back to localhost only if unset.
# Production: set to your Vercel frontend URL + Railway admin URL
# Local dev: include your LAN IP variants
ALLOWED_ORIGINS=https://deepfeed-ai.vercel.app,https://deepfeedai-admin-production.up.railway.app

# ── Auth ───────────────────────────────────────────────────────────
# REQUIRED — server will refuse to start if missing
JWT_SECRET=change_this_to_a_long_random_string

# Admin login is via Google OAuth. List the Google account emails that are
# allowed to access the admin panel (comma-separated, case-insensitive).
ADMIN_EMAILS=you@gmail.com

# ── Public User Auth (OAuth) ────────────────────────────────────────
# Separate secret for public user JWTs (different from admin JWT_SECRET)
USER_JWT_SECRET=change_this_to_another_long_random_string

# This server's public URL (used as OAuth redirect_uri base)
BASE_URL=https://deepfeedai-admin-production.up.railway.app

# Main site URL (used for post-OAuth redirect)
MAIN_SITE_URL=https://deepfeedai.com

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Add BOTH of these as Authorised Redirect URIs in your OAuth client:
#   BASE_URL/api/auth/google/callback        ← admin login
#   BASE_URL/api/user-auth/google/callback   ← public comment login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth — create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── Database ───────────────────────────────────────────────────────
# Neon Postgres connection string (Railway / Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── ElevenLabs TTS ─────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# ── Cloudflare R2 (production audio storage) ───────────────────────
# Leave blank to use local file storage (dev only)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=deepfeedai-media
R2_PUBLIC_URL=https://media.deepfeedai.com

# ── Transactional Email (Reply Notifications) ───────────────────────
# Resend — free tier: 3,000 emails/month. Get key at resend.com.
# REQUIRED for reply notifications to work. Safe to omit — skipped if unset.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address (must be from a verified domain in Resend)
# Default: notifications@deepfeedai.com
NOTIFY_FROM=Deep Feed AI <notifications@deepfeedai.com>
