# ============================================
# DeepFeedAI — Single-Tenant Deployment
# ============================================
# Minimal config for self-hosted / Docker deployments.
# For the full reference, see .env.example

# === REQUIRED ===
DATABASE_URL=postgres://deepfeed:deepfeed@postgres:5432/deepfeed
ADMIN_PASSWORD=
SETTINGS_ENCRYPTION_KEY=                 # generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Single-tenant is the default — no DEPLOYMENT_MODE needed.
# PORT=4000
# INSTANCE_NAME=

# === Storage ===
# STORAGE_BACKEND=local                  # local | s3 | database
# STORAGE_LOCAL_DIR=./public/media

# S3-compatible (optional):
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=false              # true for MinIO

# === AI (optional — also configurable via admin UI after first login) ===
# GEMINI_API_KEY=

# === Email (optional) ===
# RESEND_API_KEY=
# ADMIN_EMAIL=

# === Performance Tuning ===
# DB_POOL_MAX=10
# RATE_LIMIT_SUMMARY_MAX=30
# RATE_LIMIT_API_MAX=120
